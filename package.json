{
  "name": "latbai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pace": "esbuild tools/pace.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/pace.mjs --log-level=error && node node_modules/.cache/pace.mjs",
    "server": "esbuild server/main.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/server.mjs --log-level=error && node node_modules/.cache/server.mjs",
    "build:online": "tsc --noEmit && vite build --outDir dist-online"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
