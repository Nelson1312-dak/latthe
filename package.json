{
  "name": "lat-co",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fixtures": "node --experimental-strip-types --no-warnings scripts/gen-fixtures.ts",
    "shots": "node scripts/shots.mjs",
    "check:design": "node scripts/check-design.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "vite": "vite",
    "server": "node --env-file-if-exists=.env.chess --experimental-strip-types --no-warnings server/main.ts",
    "start": "npm run build && npm run server",
    "openings": "node scripts/import-openings.mjs",
    "eval:advisor": "node --experimental-strip-types --no-warnings scripts/eval-advisor.ts",
    "puzzles": "node scripts/import-puzzles.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "chess.js": "1.4.0",
    "cm-chessboard": "8.15.4",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "playwright": "1.65.1",
    "stockfish": "19.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
